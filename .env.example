# ═══════════════════════════════════════════════════════════════
#   AI-Таргетолог для Claude Code — переменные окружения
# ═══════════════════════════════════════════════════════════════
#
# 1) Скопируй этот файл в .env  (cp .env.example .env)
# 2) Заполни значения ниже — где брать описано в docs/00-full-setup-guide.md
# 3) НИКОГДА не коммить .env в git (он в .gitignore)
#
# ───────────────────────────────────────────────────────────────


# ──── META / FACEBOOK API ─────────────────────────────────────

# ID и Secret твоего Facebook-приложения
# https://developers.facebook.com → My Apps → твоё приложение → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# Long-lived User Access Token с правами ads_management, ads_read, business_management
# Берётся через Graph API Explorer + Token Tool (см. полный гайд)
META_ACCESS_TOKEN=


# ──── PIPEBOARD (опционально) ─────────────────────────────────

# Если используешь Pipeboard для управления Meta Auth
# Получить: https://pipeboard.co → Account → API Tokens
PIPEBOARD_API_TOKEN=


# ──── GEMINI (для генерации картинок) ─────────────────────────

# Google AI Studio API key — нужен для скилла creative-image-generator
# https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ──── ОПЦИОНАЛЬНЫЕ ФЛАГИ ──────────────────────────────────────

# Поставь "1" чтобы отключить (по умолчанию все включены):
#
# META_ADS_DISABLE_ADS_LIBRARY=
# META_ADS_DISABLE_CALLBACK_SERVER=
# META_ADS_DISABLE_LOGIN_LINK=
# META_ADS_ENABLE_DUPLICATION=1
# META_ADS_ENABLE_REPORTS=1
# META_ADS_ENABLE_SAVE_AD_IMAGE_LOCALLY=1
# META_MCP_DISABLE_DELIVERY_FALLBACK=
